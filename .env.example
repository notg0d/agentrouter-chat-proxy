# ---------------------------------------------------------------------------
# Example configuration for the AgentRouter OpenCode Proxy.
# Copy to .env and edit as needed. (.env is gitignored; never commit real keys.)
#
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Upstream gateway base URL
AGENTROUTER_UPSTREAM=https://agentrouter.org

# Fallback API key used only when incoming requests lack an Authorization header.
# Configure OpenCode to send the key in its Authorization header.
# The legacy CODEX_GATEWAY_API_KEY name remains supported.
# CODEX_GATEWAY_API_KEY=your-key-here

# Local loopback listen port (host defaults to 127.0.0.1; use CLI --host for Docker/LAN)
PROXY_PORT=8788

# OpenCode proxy listen port (supports both Chat Completions and Responses)
CHAT_PROXY_PORT=8789

# Separate local access token. Clients send X-Proxy-Token, not Authorization.
# Optional on loopback; required with --host 0.0.0.0 or another non-loopback address.
# Use a long, random token. The proxy never forwards it to AgentRouter.
# /_health remains readable without this token for supervisor probes.
PROXY_AUTH_TOKEN=

# Per-request upload and converted-payload limit: 20 MiB.
# This applies to declared and chunked uploads on all permitted routes.
PROXY_MAX_BODY_BYTES=20971520
# Total upload deadline, not a timeout for each upload chunk.
PROXY_BODY_UPLOAD_TIMEOUT_S=60

# Upstream SSE bounds: 8 MiB per frame and per initial inspection buffer.
PROXY_MAX_SSE_FRAME_BYTES=8388608
PROXY_MAX_SSE_PRIME_BYTES=8388608

# Transport / fallback retry timings
PROXY_RETRY_DELAY_MS=300
PROXY_CONNECT_TIMEOUT_S=20.0
PROXY_READ_TIMEOUT_S=600.0

# Compatibility defaults retry temporary server errors and ambiguous failures.
# Accepted upstream work can be billed again when a request is retried.
# Set BOTH to 0 for conservative retries. Connect/pool failures and rate limits
# can still use recovery; these options do not guarantee exactly-once execution.
PROXY_RETRY_ON_5XX=1
PROXY_RETRY_AMBIGUOUS_ERRORS=1

# Pre-commit SSE priming & rate-limit recovery
PROXY_RATE_LIMIT_BASE_S=2.0
# Caps generated exponential backoff only; upstream Retry-After is never shortened.
PROXY_RATE_LIMIT_MAX_DELAY_S=15.0
# Budget for pre-commit recovery, including shared cooldown waits.
# If the provider's delay exceeds the remaining budget, return 429 + Retry-After.
PROXY_MAX_RATE_LIMIT_WAIT_S=90.0
PROXY_MAX_TRANSIENT_RETRIES=6
PROXY_RECOVERY_STAGGER_S=0.6
PROXY_SSE_PRIME_FIRST_TIMEOUT_S=45.0
PROXY_SSE_PRIME_CREATED_GRACE_S=3.0

# Image cap for native Responses AND translated Chat requests; keep newest images.
PROXY_MAX_IMAGES=35

# Logging verbosity (1=info/warnings, 0=minimal)
PROXY_VERBOSE=1

# Safe fast-forward background auto-updater (used by service.py)
PROXY_AUTO_UPDATE=1
PROXY_AUTO_UPDATE_ON_START=1
PROXY_AUTO_UPDATE_INTERVAL_S=3600
